<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Release builds stamp these through build-setting overrides. Local
	     developer builds leave them empty and have no release channel. -->
	<key>ATCBuildBuiltAt</key>
	<string>$(ATC_BUILD_BUILT_AT)</string>
	<key>ATCBuildCommit</key>
	<string>$(ATC_BUILD_COMMIT)</string>
	<key>ATCBuildVersion</key>
	<string>$(ATC_BUILD_VERSION)</string>
	<!-- The server is reached over cleartext HTTP/WS on the tailnet; the
	     path is already WireGuard-encrypted, so ATS's TLS requirement is
	     waived for this POC. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
